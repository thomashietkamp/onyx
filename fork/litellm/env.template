# Copy to fork/litellm/.env (git ignores it) and fill in the values.

# The key Onyx and admins use to call the proxy. Start it with "sk-".
LITELLM_MASTER_KEY=sk-change-me
# Encrypts the provider keys the proxy stores in its database.
LITELLM_SALT_KEY=change-me-to-a-long-random-string
LITELLM_DB_PASSWORD=litellm

# Azure OpenAI
AZURE_OPENAI_API_BASE=https://<resource>.openai.azure.com
AZURE_OPENAI_API_KEY=
AZURE_OPENAI_API_VERSION=2024-10-21
# azure/<deployment name>
AZURE_OPENAI_GPT4O_MODEL=azure/gpt-4o

# Requesty. The model values are openai/<Requesty model id>: LiteLLM sends
# them to Requesty's OpenAI-compatible API.
REQUESTY_API_KEY=
REQUESTY_CLAUDE_SONNET_MODEL=openai/bedrock/claude-sonnet-5-5@eu-central-1
REQUESTY_CLAUDE_OPUS_MODEL=openai/bedrock/claude-opus-5-5@eu-central-1

# Claude on Azure AI Foundry (optional)
AZURE_CLAUDE_API_BASE=https://<resource>.services.ai.azure.com/anthropic
AZURE_CLAUDE_API_KEY=
# azure_ai/<deployment name>
AZURE_CLAUDE_MODEL=azure_ai/claude-sonnet-4-5

# Claude from Anthropic (optional)
ANTHROPIC_API_KEY=

# Self-hosted model (optional)
SELF_HOSTED_API_BASE=
SELF_HOSTED_API_KEY=none

# Copy to fork/langfuse/.env (git ignores it). Every value is required; the
# stack does not start while one is empty. Make random values with
#   openssl rand -hex 32
POSTGRES_PASSWORD=
CLICKHOUSE_PASSWORD=
MINIO_ROOT_PASSWORD=
REDIS_AUTH=
SALT=
# Exactly 64 hex characters: openssl rand -hex 32
ENCRYPTION_KEY=
NEXTAUTH_SECRET=

# The project keys Onyx sends traces with. Use the same values for
# LANGFUSE_PUBLIC_KEY and LANGFUSE_SECRET_KEY in Onyx's environment.
#   echo "pk-lf-$(openssl rand -hex 16)"   and   echo "sk-lf-$(openssl rand -hex 16)"
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=

# The Langfuse admin login.
LANGFUSE_ADMIN_EMAIL=
LANGFUSE_ADMIN_PASSWORD=

# Where people open Langfuse; links in Langfuse use it.
LANGFUSE_PUBLIC_URL=http://localhost:3110
